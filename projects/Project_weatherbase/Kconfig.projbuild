menu "Project Configuration"

    config WIFI_SSID
        string "Wi-Fi SSID"
        default "myssid"

    config WIFI_PASSWORD
        string "Wi-Fi password"
        default "mypassword"

    config SERVER_URL
        string "Server URL"
        default "http://192.168.1.100:5000/api/readings"
        help
            Laptopun IP-si ilə əvəz et.

    config DEVICE_ID
        string "Device ID"
        default "esp32s3-01"

    config TRIG_GPIO
        int "HC-SR04 TRIG GPIO"
        default 5

    config ECHO_GPIO
        int "HC-SR04 ECHO GPIO"
        default 6

    config SEND_INTERVAL_MS
        int "Göndərmə intervalı (ms)"
        default 5000

endmenu
